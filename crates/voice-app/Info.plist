<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the bundle's generated Info.plist by tauri-bundler
	     (it picks up Info.plist next to tauri.conf.json). Mirrors /Info.plist:
	     macOS kills a process that opens the microphone without a usage
	     string, and LSUIElement keeps the app out of the Dock at launch. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice listens while you hold the dictation hotkey and transcribes your speech locally on this Mac.</string>
</dict>
</plist>
