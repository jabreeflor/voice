{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice",
  "version": "2.0.0",
  "identifier": "com.local.voice",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Voice",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "onboarding",
        "title": "Set up Voice",
        "url": "onboarding.html",
        "width": 760,
        "height": 610,
        "resizable": false,
        "visible": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "overlay",
        "title": "",
        "url": "overlay.html",
        "width": 192,
        "height": 44,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
